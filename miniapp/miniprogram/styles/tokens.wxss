page {
  --color-bg: #f5f5f7;
  --color-surface: #fff;
  --color-text: #1d1d1f;
  --color-text-secondary: #6e6e73;
  --color-primary: #2f6b4f;
  --color-primary-soft: #e9f2ed;
  --color-danger: #c44747;
  --color-danger-soft: #faecec;
  --color-border: #e5e5e7;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --radius-md: 28rpx;
  --radius-lg: 36rpx;
  --shadow-soft: 0 10rpx 30rpx rgb(29 29 31 / 5%);

  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
