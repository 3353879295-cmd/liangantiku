<view class="page-shell page-shell--secondary detail-page">
  <app-topbar
    title="技能要点"
    subtitle="{{skill ? roleText : '实操技能'}}"
    fallback-tab="practical"
  />

  <block wx:if="{{skill}}">
    <view class="detail-hero">
      <image
        class="detail-hero__image"
        src="/packages/auxiliary/assets/rice-ear-hero.webp"
        mode="aspectFill"
        aria-label="成熟稻穗近景"
      />
      <view class="detail-hero__copy">
        <view class="detail-hero__role">{{roleText}}</view>
        <view class="detail-hero__title">{{skill.title}}</view>
        <text class="detail-hero__summary">{{skill.summary}}</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">作业目的</view>
      <view class="purpose-card">
        <view class="purpose-card__mark"></view>
        <text>{{skill.purpose}}</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">作业准备</view>
      <view class="plain-card">
        <view wx:for="{{skill.preparations}}" wx:key="*this" class="check-row">
          <t-icon name="check-circle" size="30rpx" color="#2f6b4f" />
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">操作步骤</view>
      <view class="step-list">
        <view wx:for="{{skill.steps}}" wx:key="title" class="step-card">
          <view class="step-card__number">{{index + 1}}</view>
          <view class="step-card__content">
            <view class="step-card__title">{{item.title}}</view>
            <text class="step-card__detail">{{item.detail}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">安全提示</view>
      <view class="warning-card">
        <view wx:for="{{skill.safetyNotes}}" wx:key="*this" class="warning-row">
          <t-icon name="error-circle" size="30rpx" />
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">常见错误</view>
      <view class="plain-card">
        <view wx:for="{{skill.commonMistakes}}" wx:key="*this" class="mistake-row">
          <text class="mistake-row__dot"></text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section__title">关联练习</view>
      <view wx:if="{{relatedLoading || !relatedReady}}" class="related-state related-state--loading">
        <t-icon name="loading" size="30rpx" />
        <text>正在读取关联题目…</text>
      </view>
      <view wx:elif="{{relatedLoadError}}" class="related-state related-state--error">
        <view class="related-state__title">关联题目加载失败</view>
        <text>请检查后重试，本次不会创建练习记录。</text>
        <button class="related-retry" loading="{{relatedLoading}}" disabled="{{relatedLoading}}" bindtap="onRetryRelatedQuestions">重新加载</button>
      </view>
      <button
        wx:elif="{{relatedQuestions.length}}"
        class="related-button"
        loading="{{startingRelatedPractice}}"
        disabled="{{startingRelatedPractice}}"
        bindtap="onStartRelatedPractice"
      >练习 {{relatedQuestions.length}} 道关联题</button>
      <view wx:else class="related-state related-state--empty">
        <view class="related-state__title">暂无关联练习</view>
        <text>当前技能还没有可用题目，可先复习上方作业要点。</text>
      </view>
    </view>

    <view class="source-card">
      <view class="source-card__label">现行知识依据</view>
      <text class="source-card__body">{{skill.standardReference}}</text>
      <text class="source-card__ids">现行来源编号：{{sourceText}}</text>
    </view>

    <view wx:if="{{skill.nonCurrentReference}}" class="source-card source-card--historical">
      <view class="source-card__label">历史/书目参考（非现行依据）</view>
      <text class="source-card__body">{{skill.nonCurrentReference}}</text>
      <text class="source-card__ids">参考来源编号：{{nonCurrentSourceText}}</text>
    </view>

    <view class="detail-disclaimer">
      本指南用于考证复习与作业要点回顾，不能替代单位规程、持证要求、现场培训和监护。
    </view>
  </block>

  <empty-state wx:else title="未找到技能卡" description="这张技能卡可能已经调整，请返回实操页。" />
</view>
