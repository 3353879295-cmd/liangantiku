.setup-page {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.setup-loading {
  display: flex;
  min-height: 140rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.fixed-practice-card {
  padding: 28rpx;
}

.fixed-practice-card__header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.fixed-practice-card__mark {
  display: flex;
  flex: 0 0 auto;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--color-primary);
  color: var(--color-text);
}

.fixed-practice-card__copy {
  min-width: 0;
}

.fixed-practice-card__eyebrow {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.fixed-practice-card__title {
  margin-top: 5rpx;
  font-size: 31rpx;
  font-weight: 680;
}

.fixed-practice-card__details {
  margin-top: 24rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-border);
}

.fixed-practice-card__row {
  display: flex;
  min-height: 50rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.fixed-practice-card__row text:last-child {
  color: var(--color-text);
  font-weight: 600;
}

.fixed-practice-card__status {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--color-primary-soft);
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.fixed-practice-card__status--disabled {
  background: var(--color-surface-secondary);
}

.start-button {
  margin-top: 22rpx;
  border-radius: var(--radius-md);
  background: var(--color-text);
  color: var(--color-surface);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.start-button::after {
  display: none;
}

.start-button[disabled] {
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
}
