<view class="page-shell page-shell--secondary setup-page">
  <app-topbar
    title="随机练习设置"
    subtitle="{{loading ? '正在读取当前题库' : bankTitle}}"
    fallback-tab="home"
  />

  <view wx:if="{{loading}}" class="setup-loading matte-card">
    <t-icon name="loading" size="36rpx" />
    <text>正在读取当前题库</text>
  </view>

  <view wx:elif="{{loadError}}" class="setup-loading matte-card">
    <text>{{loadError}}</text>
    <button class="setup-retry" bindtap="onRetryLoad">重新读取</button>
  </view>

  <block wx:else>
    <view class="quota-note">{{freePracticeText}}</view>
    <view class="fixed-practice-card matte-card">
      <view class="fixed-practice-card__header">
        <view class="fixed-practice-card__mark"><t-icon name="swap" size="36rpx" /></view>
        <view class="fixed-practice-card__copy">
          <text class="fixed-practice-card__eyebrow">随机练习</text>
          <view class="fixed-practice-card__title">{{summaryText}}</view>
        </view>
      </view>
      <view class="fixed-practice-card__details">
        <view class="fixed-practice-card__row">
          <text>当前题库</text>
          <text>{{bankQuestionCount}} 题</text>
        </view>
        <view class="fixed-practice-card__row">
          <text>抽题方式</text>
          <text>随机且不重复</text>
        </view>
      </view>
      <view class="fixed-practice-card__status {{canStart ? '' : 'fixed-practice-card__status--disabled'}}">
        <t-icon name="{{canStart ? 'check-circle' : 'info-circle'}}" size="28rpx" />
        <text>{{statusText}}</text>
      </view>
    </view>

    <button
      class="start-button"
      disabled="{{!canStart || starting}}"
      loading="{{starting}}"
      bindtap="onStart"
    >开始 {{questionCount}} 题</button>
  </block>
  <membership-prompt visible="{{memberPromptVisible}}" bind:close="onCloseMemberPrompt" bind:confirm="onOpenMember" />
</view>
