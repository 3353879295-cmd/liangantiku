.empty {
  display: flex;
  align-items: center;
  padding: 96rpx 40rpx;
  flex-direction: column;
  text-align: center;
}

.empty__mark {
  width: 68rpx;
  height: 68rpx;
  border: 4rpx solid #c9d8cf;
  border-radius: 50%;
  box-shadow: inset 0 0 0 12rpx var(--color-primary-soft);
}

.empty__title {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty__description {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.empty__action {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.empty__action::after {
  display: none;
}
