<view wx:if="{{visible}}" class="analysis">
  <view
    wx:if="{{showResult}}"
    class="analysis__result analysis__result--{{correct ? 'correct' : 'wrong'}}"
  >
    <t-icon name="{{correct ? 'check-circle-filled' : 'close-circle-filled'}}" size="40rpx" />
    <text>{{correct ? '回答正确' : '回答错误'}}</text>
  </view>

  <view class="analysis__cards">
    <view class="analysis__card">
      <view class="analysis__label">你的答案</view>
      <text class="analysis__answer analysis__answer--selected">{{selectedText || '未作答'}}</text>
    </view>
    <view class="analysis__card">
      <view class="analysis__label">正确答案</view>
      <text class="analysis__answer">{{expectedText}}</text>
    </view>
    <view class="analysis__card">
      <view class="analysis__label">题目解析</view>
      <text class="analysis__body">{{explanation}}</text>
    </view>
    <view wx:if="{{knowledgePoint}}" class="analysis__card">
      <view class="analysis__label">知识点</view>
      <text class="analysis__body">{{knowledgePoint}}</text>
    </view>
    <view class="analysis__card">
      <view class="analysis__label">易错原因</view>
      <text class="analysis__body">
        {{commonMistake || '本题暂无单独易错提示，请结合题目解析复习。'}}
      </text>
    </view>
    <view wx:if="{{standardReference}}" class="analysis__card">
      <view class="analysis__label">标准依据</view>
      <text class="analysis__body">{{standardReference}}</text>
    </view>
  </view>

  <view wx:if="{{questionId}}" class="analysis__correction">
    <button
      wx:if="{{feedbackAvailable}}"
      class="analysis__correction-button"
      open-type="feedback"
      aria-label="通过微信反馈题目纠错"
    >题目纠错</button>
    <button
      wx:else
      class="analysis__correction-button"
      aria-label="复制题目 ID 以反馈题目纠错"
      bindtap="handleCopyQuestionId"
    >题目纠错 · 复制题目 ID</button>
    <text wx:if="{{!feedbackAvailable}}" class="analysis__question-id">题目 ID：{{questionId}}</text>
  </view>
</view>
