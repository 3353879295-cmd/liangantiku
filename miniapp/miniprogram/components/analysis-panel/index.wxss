.analysis {
  margin-top: 28rpx;
}

.analysis__result {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx;
  color: var(--color-primary-strong);
  font-size: 29rpx;
  font-weight: 650;
}

.analysis__result--wrong {
  color: var(--color-danger);
}

.analysis__cards {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.analysis__card {
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}

.analysis__label {
  margin-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.analysis__answer,
.analysis__body {
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.analysis__answer {
  font-weight: 650;
}

.analysis__answer--selected {
  color: var(--color-option-text);
}

.analysis__correction {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx 4rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.analysis__correction-button {
  min-height: 44px;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 68rpx;
}

.analysis__correction-button::after {
  display: none;
}

.analysis__question-id {
  overflow: hidden;
  flex: 1;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}
