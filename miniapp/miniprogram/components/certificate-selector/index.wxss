.certificate-selector {
  padding: 30rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.selector-label {
  margin-bottom: 14rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.selector-label--level {
  margin-top: 30rpx;
}

.role-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.role-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}

.role-option--selected {
  background: var(--color-text);
  color: var(--color-surface);
  font-weight: 650;
}

.level-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-option {
  display: flex;
  flex: 1 0 26%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  padding: 8rpx 10rpx;
  border-radius: 24rpx;
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.level-option--selected {
  background: var(--color-primary);
  color: var(--color-text);
  font-weight: 650;
}

.level-option__status {
  margin-top: 3rpx;
  font-size: 18rpx;
  font-weight: 500;
  opacity: 0.7;
}
