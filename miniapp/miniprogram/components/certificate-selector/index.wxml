<view class="certificate-selector">
  <view
    wx:if="{{collapsed}}"
    class="selector-panel selector-panel--collapsed"
    hover-class="selector-panel--pressed"
    aria-role="button"
    aria-label="当前题库 {{summaryText}}，重新选择"
    bind:tap="onExpand"
  >
    <view class="collapsed-copy">
      <text class="collapsed-copy__label">当前题库</text>
      <text class="collapsed-copy__summary">{{summaryText}}</text>
    </view>
    <view class="collapsed-action">
      <text>重新选择</text>
      <view class="collapsed-action__chevron" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:else class="selector-panel selector-panel--expanded">
    <view class="selector-label">报考职业</view>
    <view class="role-options">
      <view
        wx:for="{{roles}}"
        wx:key="occupation"
        class="role-option {{item.selected ? 'role-option--selected' : ''}}"
        data-occupation="{{item.occupation}}"
        bind:tap="onRoleTap"
      >
        {{item.title}}
      </view>
    </view>

    <view class="selector-label selector-label--level">证书等级 · 共 5 级</view>
    <view class="level-options">
      <view
        wx:for="{{levels}}"
        wx:key="key"
        class="level-option {{item.selected ? 'level-option--selected' : ''}}"
        data-key="{{item.key}}"
        bind:tap="onLevelTap"
      >
        <text>{{item.name}}</text>
        <text wx:if="{{item.statusText}}" class="level-option__status">{{item.statusText}}</text>
      </view>
    </view>
  </view>
</view>
