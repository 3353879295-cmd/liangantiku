<view class="page-shell report-page">
  <view wx:if="{{ready && view}}">
    <view class="result-kicker">本次练习</view>
    <view class="score-block">
      <view class="score-ring">
        <text class="score-ring__value">{{view.scoreText}}</text>
        <text class="score-ring__unit">分</text>
      </view>
      <view class="score-block__title">练习完成</view>
      <text class="score-block__note">每次看清错因，下一组会更稳。</text>
    </view>

    <view class="report-stats">
      <stat-card label="正确率" value="{{view.accuracyText}}" note="本次" />
      <stat-card label="正确" value="{{view.correctText}}" note="题" />
      <stat-card label="用时" value="{{view.durationText}}" note="分:秒" />
    </view>

    <view class="report-section">
      <view class="report-section__title">模块表现</view>
      <view class="module-results">
        <view wx:for="{{view.weakModules}}" wx:key="name" class="module-result">
          <view>
            <view class="module-result__name">{{item.name}}</view>
            <text class="module-result__summary">{{item.summary}}</text>
          </view>
          <text class="module-result__accuracy">{{item.accuracyText}}</text>
        </view>
      </view>
    </view>

    <button
      class="primary-button {{hasWrong ? '' : 'primary-button--disabled'}}"
      disabled="{{!hasWrong}}"
      bindtap="onReviewWrong"
    >{{hasWrong ? '查看错题解析' : '本组没有错题'}}</button>
    <button class="secondary-button" bindtap="onRetry">再练一组</button>
    <view class="home-link" bind:tap="onBackHome">返回首页</view>
  </view>

  <empty-state
    wx:else
    title="暂时没有练习结果"
    description="完成一组题目后，这里会显示成绩和薄弱模块。"
  />
</view>
