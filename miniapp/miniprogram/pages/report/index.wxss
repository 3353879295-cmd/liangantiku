.report-page {
  min-height: 100vh;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

.review-topbar {
  position: relative;
}

.review-topbar__theme {
  position: absolute;
  top: 6rpx;
  right: 0;
}

.review-topbar__main {
  padding-right: 92rpx;
}

.report-state {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
  box-shadow: var(--shadow-soft);
}

.report-state--error {
  display: block;
  background: var(--color-danger-soft);
}

.report-state__title {
  margin-bottom: 8rpx;
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 650;
}

.report-retry {
  width: fit-content;
  min-height: 72rpx;
  margin: 22rpx 0 0;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 72rpx;
}

.report-retry::after {
  display: none;
}

.result-kicker {
  color: var(--color-primary-strong);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  text-align: center;
}

.score-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 38rpx;
}

.score-ring {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  border: 14rpx solid var(--color-primary-soft);
  border-radius: 50%;
  color: var(--color-text);
  line-height: 220rpx;
  box-shadow: inset 0 0 0 3rpx var(--color-primary);
}

.score-ring__value {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: -4rpx;
}

.score-ring__unit {
  margin-left: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.score-block__title {
  margin-top: 26rpx;
  font-size: 40rpx;
  font-weight: 650;
}

.score-block__note {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.report-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.report-section {
  margin-top: 42rpx;
}

.report-section__title {
  margin: 0 4rpx 18rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.module-results {
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.module-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  margin-left: 28rpx;
  padding: 16rpx 28rpx 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.module-result:last-child {
  border-bottom: 0;
}

.module-result__name {
  margin-bottom: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.module-result__summary {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.module-result__accuracy {
  color: var(--color-primary-strong);
  font-size: 27rpx;
  font-weight: 650;
}

.module-result__actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
}

.module-result__practice {
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 650;
  line-height: 52rpx;
}

.module-result__practice::after {
  display: none;
}

.theme-night .module-result__accuracy {
  color: var(--color-primary);
}

.primary-button,
.secondary-button {
  min-height: 92rpx;
  margin-top: 34rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.primary-button {
  background: var(--color-text);
  color: var(--color-surface);
}

.theme-night .primary-button {
  background: var(--color-primary);
  color: #11120f;
}

.secondary-button {
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}

.secondary-button--disabled[disabled] {
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
  opacity: 1;
}

.primary-button::after,
.secondary-button::after {
  display: none;
}

.home-link {
  padding: 28rpx 0;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  text-align: center;
}
