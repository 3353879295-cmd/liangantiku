<view class="page-shell profile-page">
  <view class="profile-header">
    <view class="profile-avatar">粮</view>
    <view>
      <view class="page-title">我的学习</view>
      <text class="page-subtitle">{{certificateTitle}}</text>
    </view>
  </view>

  <view class="profile-stats">
    <stat-card label="累计练习" value="{{dashboard.answeredText}}" note="题" />
    <stat-card label="正确率" value="{{dashboard.accuracyText}}" note="累计" />
    <stat-card label="坚持学习" value="{{dashboard.streakText}}" note="当前" />
  </view>

  <view class="section-title">近七天</view>
  <view class="activity-card">
    <view wx:for="{{activity}}" wx:key="date" class="activity-day">
      <view class="activity-day__count">{{item.answered}}</view>
      <view class="activity-day__track">
        <view class="activity-day__bar" style="height: {{item.height}}rpx;"></view>
      </view>
      <text class="activity-day__label">{{item.label}}</text>
    </view>
  </view>

  <view class="section-title">复习</view>
  <view class="settings-card">
    <view class="setting-row" bind:tap="onOpenWrong">
      <view class="setting-row__left">
        <view class="setting-icon setting-icon--wrong"><t-icon name="error-circle" size="34rpx" /></view>
        <text>错题本</text>
      </view>
      <view class="setting-row__right"><text>{{wrongCount}} 题</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>
    <view class="setting-row" bind:tap="onOpenFavorite">
      <view class="setting-row__left">
        <view class="setting-icon"><t-icon name="star" size="34rpx" /></view>
        <text>我的收藏</text>
      </view>
      <view class="setting-row__right"><text>{{favoriteCount}} 题</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>
  </view>

  <view class="section-title">设置</view>
  <view class="settings-card">
    <view class="setting-row" bind:tap="onChangeCertificate">
      <view class="setting-row__left"><text>当前证书</text></view>
      <view class="setting-row__right"><text>{{certificateTitle}}</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>
    <view class="setting-row" bind:tap="onChangeGoal">
      <view class="setting-row__left"><text>每日目标</text></view>
      <view class="setting-row__right"><text>{{dailyGoal}} 题</text><t-icon name="chevron-right" size="30rpx" /></view>
    </view>
    <view class="setting-row setting-row--danger" bind:tap="onClearLearningData">
      <view class="setting-row__left"><text>清除学习数据</text></view>
    </view>
  </view>

  <view class="version">粮安题库 0.1.0 · 题目解析仅用于学习参考</view>
</view>
