<view class="page-shell profile-page">
  <view class="profile-header">
    <view class="profile-identity">
      <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" bind:error="onAvatarError" />
      <view wx:else class="profile-avatar profile-avatar--fallback">粮</view>
      <view class="profile-copy">
        <view class="profile-name">{{nickname}}</view>
        <text class="profile-certificate">{{certificateTitle}}</text>
      </view>
    </view>
    <view class="edit-profile" bind:tap="onOpenEditProfile">
      <text>编辑资料</text>
      <t-icon name="chevron-right" size="28rpx" />
    </view>
  </view>

  <view wx:if="{{accountStatus === 'guest'}}" class="account-status-card">
    <view class="account-status-card__title">当前为游客</view>
    <text>记录仅保存在本机，登录后以云端数据为准</text>
    <button class="account-status-card__button" bind:tap="onLoginAndSync">登录并同步</button>
  </view>
  <view wx:else class="account-status-card">
    <view class="account-status-card__title">{{syncText}}</view>
    <text>{{accountDetail || lastSyncedAt}}</text>
    <button
      wx:if="{{accountStatus === 'offline' || accountStatus === 'recovering'}}"
      class="account-status-card__button"
      bind:tap="onLoginAndSync"
    >
      登录并重试
    </button>
    <button wx:elif="{{syncFailed}}" class="account-status-card__button" bind:tap="onRetrySync">
      重试同步
    </button>
  </view>

  <view class="member-card" bind:tap="onOpenMember">
    <view>
      <text class="member-card__eyebrow">会员权益</text>
      <view class="member-card__title">{{membershipStatus}}</view>
      <text class="member-card__note">{{membershipDetail}}</text>
      <text wx:if="{{membershipPractice}}" class="member-card__note">{{membershipPractice}}</text>
    </view>
    <view class="member-card__action">{{isMember ? '查看会员' : '开通会员'}}</view>
  </view>

  <view class="profile-stats">
    <stat-card label="累计练习" value="{{dashboard.answeredText}}" note="题" />
    <stat-card label="正确率" value="{{dashboard.accuracyText}}" note="累计" />
    <stat-card label="连续学习" value="{{dashboard.streakText}}" note="当前" />
  </view>

  <view class="goal-card" bind:tap="onOpenLearningSettings">
    <view class="goal-card__heading">
      <view>
        <text class="goal-card__eyebrow">今日目标</text>
        <view class="goal-card__value">{{dashboard.goalText}}</view>
      </view>
      <view class="goal-card__percent">{{dashboard.goalPercent}}%</view>
    </view>
    <view class="goal-card__track">
      <view class="goal-card__progress" style="width: {{dashboard.goalPercent}}%;"></view>
    </view>
  </view>

  <view class="section-heading profile-section-heading">
    <view class="section-title">近七天</view>
    <text class="section-note">学习题数</text>
  </view>
  <view class="activity-card">
    <view wx:for="{{activity}}" wx:key="date" class="activity-day">
      <view class="activity-day__count">{{item.answered}}</view>
      <view class="activity-day__track">
        <view class="activity-day__bar" style="height: {{item.height}}rpx;"></view>
      </view>
      <text class="activity-day__label">{{item.label}}</text>
    </view>
  </view>

  <view class="section-heading profile-section-heading">
    <view class="section-title">更多服务</view>
  </view>
  <view class="menu-card">
    <view class="menu-row" bind:tap="onOpenLearningReport">
      <view class="menu-row__left">
        <view class="menu-row__icon"><t-icon name="chart-bar" size="32rpx" /></view>
        <view>
          <view class="menu-row__title">学习报告</view>
          <text class="menu-row__note">查看趋势与薄弱章节</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="30rpx" />
    </view>
    <view class="menu-row" bind:tap="onOpenLearningSettings">
      <view class="menu-row__left">
        <view class="menu-row__icon"><t-icon name="setting" size="32rpx" /></view>
        <view>
          <view class="menu-row__title">学习设置</view>
          <text class="menu-row__note">每日目标与答题主题</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="30rpx" />
    </view>
    <view wx:if="{{accountStatus !== 'guest'}}" class="menu-row" bind:tap="onOpenAccountData">
      <view class="menu-row__left">
        <view class="menu-row__icon"><t-icon name="setting" size="32rpx" /></view>
        <view>
          <view class="menu-row__title">账号与数据</view>
          <text class="menu-row__note">同步、退出登录与账号注销</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="30rpx" />
    </view>
    <view wx:else class="menu-row menu-row--danger" bind:tap="onClearLearningData">
      <view class="menu-row__left">
        <view class="menu-row__icon"><t-icon name="delete" size="32rpx" /></view>
        <view>
          <view class="menu-row__title">数据管理</view>
          <text class="menu-row__note">清除学习记录并保留偏好</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="30rpx" />
    </view>
    <button class="menu-row feedback-row" open-type="feedback">
      <view class="menu-row__left">
        <view class="menu-row__icon"><t-icon name="chat" size="32rpx" /></view>
        <view class="feedback-row__copy">
          <view class="menu-row__title">意见反馈</view>
          <text class="menu-row__note">通过微信官方反馈能力提交</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="30rpx" />
    </button>
  </view>

  <view class="version">粮安题库 0.1.0 · 题目解析仅用于学习参考</view>
</view>
