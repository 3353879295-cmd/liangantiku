<view class="page-shell page-shell--secondary library-page">
  <app-topbar title="教材目录" subtitle="{{selectedTitle}}" fallback-tab="home" />

  <view wx:if="{{comingSoon}}" class="availability-card">
    <view class="availability-card__mark">待</view>
    <view class="availability-card__eyebrow">当前选择</view>
    <view class="availability-card__title">{{occupationTitle}} · {{levelName}}</view>
    <text class="availability-card__body">
      当前职业与等级的教材目录和题库正在整理，暂不能开始练习。返回首页可切换到已开放等级。
    </text>
  </view>

  <view wx:elif="{{loading}}" class="loading-card">正在读取当前教材目录…</view>

  <view wx:elif="{{loadError}}" class="loading-card">
    <text>{{loadError}}</text>
    <button class="retry-button" bindtap="onRetryLoad">重新读取</button>
  </view>

  <block wx:else>
    <view class="catalog-context">
      <view class="catalog-context__info">
        <text class="catalog-context__label">当前题库</text>
        <view class="catalog-context__title">{{occupationTitle}} · {{levelName}}</view>
        <text class="catalog-context__meta">
          {{questionCount ? '已收录 ' + questionCount + ' 题' : '题目待补充'}}
        </text>
        <text wx:if="{{questionCount}}" class="catalog-context__meta">已完成 {{completedCount}} 题 · 每组 20 题</text>
        <text wx:if="{{questionCount}}" class="catalog-context__hint">按顺序刷完全部，退出后可继续</text>
      </view>
      <button
        class="catalog-context__status"
        loading="{{starting}}"
        disabled="{{starting || !questionCount || (completedCount >= questionCount && !hasSequentialResume)}}"
        aria-label="{{hasSequentialResume ? '继续当前题库的全部题目练习' : '按顺序练习当前题库全部未完成题目'}}"
        bindtap="onStartAll"
      >{{!questionCount ? '待补充' : hasSequentialResume ? '继续刷题' : completedCount >= questionCount ? '已刷完' : '全部刷题'}}</button>
    </view>

    <view class="catalog-filter">
      <view>
        <view class="catalog-filter__title">{{showingAll ? '完整教材目录' : '可练习章节'}}</view>
        <text class="catalog-filter__note">已收录 {{availableChapterCount}} 章{{unavailableChapterCount ? ' · ' + unavailableChapterCount + ' 章暂无题目' : ''}}</text>
      </view>
      <button class="catalog-filter__button" bindtap="onToggleCatalog">{{showingAll ? '只看可练' : '完整目录'}}</button>
    </view>

    <view wx:if="{{parts.length}}" class="catalog">
      <view wx:for="{{parts}}" wx:key="id" class="catalog-part">
        <view class="catalog-part__heading">
          <text class="catalog-part__eyebrow">{{item.numberText}}</text>
          <view class="catalog-part__title">{{item.title}}</view>
        </view>

        <view class="catalog-part__chapters">
          <view
            wx:for="{{item.chapters}}"
            wx:for-item="chapter"
            wx:key="id"
            class="chapter-card"
            data-chapter-id="{{chapter.id}}"
            bind:tap="onChapterTap"
          >
            <view class="chapter-card__number">{{chapter.numberText}}</view>
            <view class="chapter-card__content">
              <view class="chapter-card__topline">
                <view class="chapter-card__title">{{chapter.title}}</view>
                <view class="chapter-card__availability">
                  {{chapter.canStart ? chapter.statusText : '暂无题目'}}
                </view>
              </view>
              <view class="chapter-card__counts">
                <text>{{chapter.sectionCountText}}</text>
                <text>{{chapter.questionCountText}}</text>
              </view>
              <view class="chapter-card__metrics">
                <text>完成 {{chapter.progressText}}</text>
                <text>正确率 {{chapter.accuracyText}}</text>
                <text>错题 {{chapter.wrongText}}</text>
              </view>
            </view>
            <view class="chapter-card__chevron">
              <t-icon name="chevron-right" size="32rpx" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="catalog-empty">
      <view class="catalog-empty__title">暂时没有可练习章节</view>
      <text class="catalog-empty__body">
        {{showingAll ? occupationTitle + ' ' + levelName + '的教材目录正在整理，请稍后再来。' : '完整目录仍可查看章节编号和内容覆盖情况。'}}
      </text>
      <button wx:if="{{!showingAll}}" class="catalog-filter__button catalog-empty__button" bindtap="onToggleCatalog">查看完整目录</button>
    </view>
  </block>
</view>
