.library-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.availability-card,
.loading-card,
.catalog-context,
.catalog-empty,
.chapter-card {
  border-radius: var(--radius-lg);
}

.retry-button {
  width: 220rpx;
  min-height: 72rpx;
  margin: 20rpx 0 0;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 23rpx;
  line-height: 72rpx;
}

.retry-button::after {
  border: 0;
}

.availability-card {
  padding: 40rpx 36rpx;
  background: var(--color-text);
  color: var(--color-surface);
}

.availability-card__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.availability-card__eyebrow,
.catalog-context__label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.availability-card__eyebrow {
  color: var(--color-primary);
}

.availability-card__title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.35;
}

.availability-card__body {
  display: block;
  margin-top: 20rpx;
  color: rgb(255 255 255 / 72%);
  font-size: 25rpx;
  line-height: 1.7;
}

.loading-card,
.catalog-empty {
  padding: 36rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
  box-shadow: var(--shadow-soft);
}

.catalog-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  background: var(--color-text);
  color: var(--color-surface);
}

.catalog-context__label {
  color: var(--color-primary);
}

.catalog-context__info {
  flex: 1;
  min-width: 0;
}

.catalog-context__hint {
  display: block;
  margin-top: 12rpx;
  color: rgb(255 255 255 / 80%);
  font-size: 21rpx;
  line-height: 1.5;
}

.catalog-context__title {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.catalog-context__meta {
  display: block;
  margin-top: 8rpx;
  color: rgb(255 255 255 / 64%);
  font-size: 23rpx;
}

.catalog-context__status,
.chapter-card__availability {
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-text);
  font-weight: 650;
}

.catalog-context__status {
  min-height: 44px;
  margin: 0;
  padding: 0 22rpx;
  font-size: 22rpx;
  line-height: 44px;
  white-space: nowrap;
}

.catalog-context__status::after {
  border: 0;
}

.catalog-context__status[disabled] {
  background: var(--color-primary-soft);
  color: #243600;
}

.catalog {
  padding-top: 40rpx;
}

.catalog-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary-soft);
}

.catalog-filter__title {
  font-size: 26rpx;
  font-weight: 650;
}

.catalog-filter__note {
  display: block;
  margin-top: 5rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.catalog-filter__button {
  flex: 0 0 auto;
  min-height: 60rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 60rpx;
}

.catalog-filter__button::after {
  border: 0;
}

.catalog-part + .catalog-part {
  margin-top: 36rpx;
}

.catalog-part__heading {
  padding: 0 6rpx 16rpx;
}

.catalog-part__eyebrow {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-part__title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.catalog-part__chapters {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chapter-card {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 26rpx 24rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.chapter-card__number {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 700;
}

.chapter-card__content {
  min-width: 0;
  flex: 1;
}

.chapter-card__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.chapter-card__title {
  min-width: 0;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
}

.chapter-card__availability {
  padding: 7rpx 13rpx;
  font-size: 19rpx;
}

.chapter-card__counts,
.chapter-card__metrics {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  color: var(--color-text-secondary);
}

.chapter-card__counts {
  gap: 8rpx 18rpx;
  margin-top: 11rpx;
  font-size: 23rpx;
}

.chapter-card__metrics {
  gap: 8rpx 16rpx;
  margin-top: 15rpx;
  font-size: 21rpx;
}

.chapter-card__chevron {
  display: flex;
  width: 36rpx;
  height: 68rpx;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
}

.catalog-empty {
  margin-top: 32rpx;
}

.catalog-empty__title {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 650;
}

.catalog-empty__body {
  display: block;
  margin-top: 10rpx;
}

.catalog-empty__button {
  margin-top: 20rpx;
}
