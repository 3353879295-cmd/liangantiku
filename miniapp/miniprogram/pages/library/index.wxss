.library-page {
  padding-top: 28rpx;
}

.certificate-group {
  margin-top: 34rpx;
}

.certificate-group + .certificate-group {
  margin-top: 22rpx;
}

.certificate-group__title {
  margin: 0 4rpx 14rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.certificate-row {
  display: flex;
  gap: 12rpx;
}

.certificate-chip {
  min-width: 156rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 25rpx;
  text-align: center;
}

.certificate-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.library-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.library-summary__title {
  margin-bottom: 6rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.library-summary__note {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.library-summary__badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.mode-card {
  min-height: 178rpx;
  padding: 26rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.mode-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.mode-card__title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.mode-card__note {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
}

.catalog {
  padding-top: 44rpx;
}

.section-title {
  margin: 0 4rpx 18rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.catalog-part {
  margin-bottom: 28rpx;
}

.catalog-part__heading {
  padding: 0 4rpx 14rpx;
}

.catalog-part__eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-part__title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.catalog-part__chapters {
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.catalog-chapter + .catalog-chapter {
  border-top: 1rpx solid var(--color-border);
}

.catalog-chapter__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 20rpx 28rpx;
}

.catalog-chapter__copy,
.catalog-section__copy {
  min-width: 0;
  flex: 1;
}

.catalog-chapter__number,
.catalog-section__number {
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.catalog-chapter__title {
  margin: 5rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.catalog-chapter__meta,
.catalog-section__count {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.catalog-chapter__chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 88rpx;
  margin-left: 12rpx;
  transition: transform 160ms ease;
}

.catalog-chapter__chevron--expanded {
  transform: rotate(180deg);
}

.catalog-section-list {
  margin-left: 28rpx;
  border-top: 1rpx solid var(--color-border);
}

.catalog-section {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 10rpx 28rpx 10rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.catalog-section__title {
  margin: 4rpx 20rpx 4rpx 0;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.45;
}

.catalog-section__action,
.catalog-section__pending {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 88rpx;
  margin-left: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.catalog-section__action {
  color: var(--color-primary);
}

.catalog-section__pending {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.catalog-chapter__practice {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}
