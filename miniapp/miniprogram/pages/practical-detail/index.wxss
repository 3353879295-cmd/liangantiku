.detail-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.detail-hero,
.plain-card,
.purpose-card,
.step-card,
.warning-card,
.source-card,
.related-state {
  border-radius: var(--radius-lg);
}

.detail-hero {
  overflow: hidden;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.detail-hero__image {
  display: block;
  width: 100%;
  height: 340rpx;
  background: var(--color-surface-secondary);
}

.detail-hero__copy {
  padding: 30rpx 32rpx 34rpx;
}

.detail-hero__role {
  margin-bottom: 8rpx;
  color: var(--color-primary-strong);
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.detail-hero__title {
  font-size: 42rpx;
  font-weight: 680;
  line-height: 1.35;
}

.detail-hero__summary {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.detail-section {
  margin-top: 42rpx;
}

.detail-section__title {
  margin: 0 6rpx 18rpx;
  font-size: 34rpx;
  font-weight: 680;
}

.plain-card,
.purpose-card,
.source-card,
.related-state {
  padding: 26rpx 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.purpose-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.purpose-card__mark {
  width: 14rpx;
  height: 42rpx;
  flex: 0 0 14rpx;
  margin-top: 2rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.check-row,
.mistake-row,
.warning-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 26rpx;
  line-height: 1.65;
}

.check-row + .check-row,
.mistake-row + .mistake-row,
.warning-row + .warning-row {
  margin-top: 18rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-card {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.step-card__number {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 700;
}

.step-card__content {
  min-width: 0;
  flex: 1;
}

.step-card__title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.step-card__detail {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.warning-card {
  padding: 24rpx 26rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.mistake-row__dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 17rpx;
  border-radius: 50%;
  background: var(--color-danger);
}

.related-button {
  min-height: 96rpx;
  margin: 0;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.related-button::after {
  display: none;
}

.related-state {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.related-state:not(.related-state--empty) {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.related-state--empty {
  background: var(--color-surface-secondary);
  box-shadow: none;
}

.related-state__title {
  margin-bottom: 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 650;
}

.source-card {
  margin-top: 42rpx;
}

.source-card__label {
  margin-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.source-card__body,
.source-card__ids {
  display: block;
  font-size: 25rpx;
  line-height: 1.65;
}

.source-card__ids {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.detail-disclaimer {
  padding: 28rpx 16rpx 0;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
