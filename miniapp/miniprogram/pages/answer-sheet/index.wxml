<view class="page-shell sheet-page">
  <view wx:if="{{ready}}">
    <view class="page-title">{{modeText}}</view>
    <text class="page-subtitle">{{answeredText}}</text>

    <view class="legend">
      <view class="legend__item"><text class="legend__dot legend__dot--answered"></text>已答</view>
      <view class="legend__item"><text class="legend__dot"></text>未答</view>
      <view class="legend__item"><text class="legend__ring"></text>当前</view>
    </view>

    <view class="sheet-grid">
      <view
        wx:for="{{items}}"
        wx:key="index"
        class="sheet-cell sheet-cell--{{item.status}} {{item.current ? 'sheet-cell--current' : ''}}"
        data-index="{{item.index}}"
        bind:tap="onSelectQuestion"
      >{{item.number}}</view>
    </view>

    <view class="sheet-footer">
      <button class="submit-button" bindtap="onSubmit">交卷并查看结果</button>
    </view>
  </view>

  <empty-state
    wx:else
    title="没有进行中的练习"
    description="请先从题库选择一种练习方式。"
  />
</view>
