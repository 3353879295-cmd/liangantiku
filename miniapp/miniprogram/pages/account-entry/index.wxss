.account-entry {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.account-entry__hero {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 44rpx;
  border-radius: 42rpx;
  background: var(--color-primary);
  color: var(--color-text);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 132rpx;
}

.account-entry__title {
  font-size: 42rpx;
  font-weight: 700;
}

.account-entry__note,
.account-entry__error {
  display: block;
  margin: 20rpx 28rpx 48rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.account-entry__error {
  margin-bottom: 24rpx;
  color: var(--color-danger);
}

.account-entry__primary,
.account-entry__secondary {
  width: 100%;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.account-entry__primary {
  background: var(--color-primary);
  color: var(--color-text);
}

.account-entry__secondary {
  margin-top: 22rpx;
  background: transparent;
  color: var(--color-text-secondary);
}

.account-entry__loading {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.account-entry__spinner {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 28rpx;
  border: 6rpx solid var(--color-primary-soft);
  border-top-color: var(--color-primary-strong);
  border-radius: 50%;
}
