.list-page {
  padding-top: 30rpx;
  padding-bottom: 160rpx;
}

.filter-section {
  margin-top: 30rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-row--levels {
  display: flex;
  margin-bottom: 14rpx;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.filter-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 600;
}

.mastered-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.mastered-toggle--active {
  color: var(--color-primary);
}

.retired-note {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #eeeef0;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.question-item {
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.question-item__head,
.question-item__tags,
.question-item__actions,
.analysis-toggle {
  display: flex;
  align-items: center;
}

.question-item__head {
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.question-item__tags {
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag,
.wrong-count,
.mastered-label {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
}

.wrong-count {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.mastered-label {
  background: #eeeef0;
  color: var(--color-text-secondary);
}

.latest {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.question-item__stem {
  padding: 24rpx 28rpx 26rpx;
  font-size: 30rpx;
  font-weight: 520;
  line-height: 1.6;
}

.question-item__actions {
  justify-content: space-between;
  min-height: 78rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.analysis-toggle {
  gap: 4rpx;
}

.mastered-action {
  color: var(--color-text-secondary);
}

.inline-analysis {
  padding: 26rpx 28rpx 30rpx;
  border-top: 1rpx solid var(--color-border);
  background: #fafafa;
}

.inline-analysis__answer {
  margin-bottom: 18rpx;
  color: var(--color-primary);
  font-size: 27rpx;
  font-weight: 650;
}

.inline-analysis__body {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.inline-analysis__tip,
.inline-analysis__source {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}

.inline-analysis__tip {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.list-footer {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgb(245 245 247 / 94%);
}

.practice-button {
  min-height: 92rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.practice-button::after {
  display: none;
}
