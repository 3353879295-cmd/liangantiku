.list-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text);
}

.review-topbar {
  position: relative;
}

.review-topbar__theme {
  position: absolute;
  top: 6rpx;
  right: 0;
}

.review-topbar__main {
  padding-right: 92rpx;
}

.scope-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 28rpx 30rpx;
  border-radius: var(--radius-lg);
  background: var(--color-text);
  color: var(--color-surface);
}

.scope-card__label {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.scope-card__title {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.scope-card__note {
  color: rgb(255 255 255 / 62%);
  font-size: 21rpx;
}

.theme-night .scope-card {
  background: var(--color-surface);
  color: var(--color-text);
}

.theme-night .scope-card__note {
  color: var(--color-text-secondary);
}

.filter-section {
  margin-top: 30rpx;
}

.filter-section__label {
  display: block;
  margin: 0 4rpx 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.filter-section__label--spaced {
  margin-top: 22rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 44px;
  min-height: 44px;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.filter-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-text);
  font-weight: 650;
}

.mastered-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44px;
  margin-top: 22rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.mastered-toggle--active {
  color: var(--color-primary-strong);
}

.retired-note {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.list-progress {
  margin-top: 22rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  text-align: right;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.question-item {
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.question-item__head,
.question-item__tags,
.question-item__actions,
.analysis-toggle {
  display: flex;
  align-items: center;
}

.question-item__head {
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.question-item__tags {
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag,
.wrong-count,
.mastered-label {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-text);
  font-size: 21rpx;
}

.wrong-count {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.mastered-label {
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
}

.latest {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.question-item__stem {
  padding: 24rpx 28rpx 26rpx;
  font-size: 30rpx;
  font-weight: 520;
  line-height: 1.6;
}

.question-item__actions {
  justify-content: space-between;
  min-height: 78rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-primary-strong);
  font-size: 24rpx;
  font-weight: 650;
}

.theme-night .question-item__actions {
  color: var(--color-primary);
}

.analysis-toggle {
  gap: 4rpx;
  min-height: 44px;
}

.mastered-action {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--color-text-secondary);
}

.inline-analysis {
  padding: 2rpx 28rpx 30rpx;
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg);
}

.load-more {
  margin-top: 24rpx;
  text-align: center;
}

.load-more__button {
  min-width: 210rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-primary-strong);
  font-size: 24rpx;
}

.load-more__button::after {
  border: 0;
}

.list-footer {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgb(244 246 238 / 94%);
}

.theme-night .list-footer {
  background: rgb(21 25 17 / 94%);
}

.practice-button {
  min-height: 92rpx;
  border-radius: 24rpx;
  background: var(--color-text);
  color: var(--color-surface);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.theme-night .practice-button {
  background: var(--color-primary);
  color: #11120f;
}

.practice-button::after {
  display: none;
}
