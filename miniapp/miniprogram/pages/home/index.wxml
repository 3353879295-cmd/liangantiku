<view class="page-shell home-page">
  <view class="user-bar">
    <view class="user-profile">
      <image wx:if="{{avatarUrl}}" class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="user-avatar user-avatar--fallback">粮</view>
      <view class="user-copy">
        <text class="user-copy__meta">备考第 {{preparationDays}} 天</text>
        <view class="user-copy__name">{{nickname}}</view>
      </view>
    </view>
    <view class="member-entry" bind:tap="onOpenMember">会员权益</view>
  </view>

  <view class="home-title">粮安题库</view>

  <view class="resume-card" bind:tap="onResume">
    <view class="resume-card__copy">
      <text class="resume-card__label">{{hasResume ? '继续上次练习' : '准备开始'}}</text>
      <view class="resume-card__title">{{resumeText}}</view>
    </view>
    <view class="resume-card__action">{{resumeActionText}}</view>
  </view>

  <view class="section-heading">
    <view class="section-title">选择题库</view>
    <text class="section-note">先职业，再等级</text>
  </view>
  <certificate-selector
    certificates="{{certificates}}"
    selected-key="{{selectedKey}}"
    bind:change="onCertificateChange"
  />

  <view class="section-heading">
    <view class="section-title">开始学习</view>
    <text class="section-note">{{certificate.questionCountText}}</text>
  </view>
  <view class="action-grid">
    <view
      wx:for="{{actions}}"
      wx:key="id"
      class="action-card {{item.emphasized ? 'action-card--emphasized' : ''}}"
      data-id="{{item.id}}"
      bind:tap="onAction"
    >
      <view class="action-card__icon"><t-icon name="{{item.icon}}" size="38rpx" /></view>
      <view class="action-card__copy">
        <view class="action-card__title">{{item.title}}</view>
        <text class="action-card__note">
          {{certificate.canStart ? item.note : '待补充 · 暂不可开始'}}
        </text>
      </view>
      <t-icon wx:if="{{item.emphasized}}" name="chevron-right" size="34rpx" />
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title">当前目录</view>
      <text class="catalog-context">{{certificate.bankTitle}}</text>
    </view>
    <view class="section-link" bind:tap="onOpenCatalog">完整目录</view>
  </view>
  <view class="catalog-card" bind:tap="onOpenCatalog">
    <view wx:if="{{catalogChapters.length}}">
      <view wx:for="{{catalogChapters}}" wx:key="id" class="catalog-row">
        <view class="catalog-row__number">{{item.numberText}}</view>
        <view class="catalog-row__copy">
          <view class="catalog-row__title">{{item.title}}</view>
          <text class="catalog-row__meta">{{item.metaText}} · 完成 {{item.progressText}}</text>
        </view>
        <t-icon name="chevron-right" size="30rpx" />
      </view>
    </view>
    <view wx:else class="catalog-empty">
      <view class="catalog-empty__mark"><t-icon name="info-circle" size="28rpx" /></view>
      <text>{{loading ? '正在加载当前目录' : '当前等级目录待补充'}}</text>
    </view>
  </view>
</view>
