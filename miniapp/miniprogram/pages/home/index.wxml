<view class="page-shell home-page">
  <view class="user-bar">
    <view class="user-profile">
      <image wx:if="{{avatarUrl}}" class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" bind:error="onAvatarError" />
      <view wx:else class="user-avatar user-avatar--fallback">粮</view>
      <view class="user-copy">
        <text class="user-copy__meta">备考第 {{preparationDays}} 天</text>
        <view class="user-copy__name">{{nickname}}</view>
      </view>
    </view>
    <view class="member-entry" bind:tap="onOpenMember">会员权益</view>
  </view>

  <view class="home-title">粮安题库</view>

  <view class="resume-card" bind:tap="onResume">
    <view class="resume-card__copy">
      <text class="resume-card__label">{{hasResume ? '继续上次练习' : hasResult ? '上次练习结果' : '准备开始'}}</text>
      <view class="resume-card__title">{{resumeText}}</view>
    </view>
    <view class="resume-card__action">{{resumeActionText}}</view>
  </view>

  <view wx:if="{{selectorExpanded}}" class="section-heading">
    <view class="section-title">选择题库</view>
    <text class="section-note">先职业，再等级</text>
  </view>
  <view wx:if="{{!selectorExpanded}}" class="current-certificate" bind:tap="onOpenCertificateSelector">
    <view>
      <text class="current-certificate__label">当前题库</text>
      <view class="current-certificate__title">{{certificate.bankTitle}}</view>
    </view>
    <view class="current-certificate__action">切换 <t-icon name="chevron-right" size="28rpx" /></view>
  </view>
  <certificate-selector
    wx:else
    certificates="{{certificates}}"
    selected-key="{{selectedKey}}"
    bind:change="onCertificateChange"
  />
  <button wx:if="{{selectorExpanded}}" class="confirm-certificate" bindtap="onConfirmCertificateSelection">使用当前题库</button>

  <view class="section-heading section-heading--learning">
    <view class="section-title">开始练习</view>
    <text class="section-note">{{loading ? '正在加载题库' : loadError ? '题库读取失败' : certificate.questionCountText}}</text>
  </view>
  <button wx:if="{{loadError}}" class="load-retry" bindtap="onRetryLoad">题库暂时无法读取，点击重试</button>
  <view class="action-grid">
    <view
      wx:for="{{actions}}"
      wx:key="id"
      class="action-card action-card--{{item.id}} {{item.emphasized ? 'action-card--emphasized' : ''}}"
      data-id="{{item.id}}"
      bind:tap="onAction"
    >
      <view class="action-card__icon"><t-icon name="{{item.icon}}" size="38rpx" /></view>
      <view class="action-card__copy">
        <view class="action-card__title">{{item.title}}</view>
        <text class="action-card__note">{{loading ? '题库加载中，请稍候' : loadError ? '请先重新加载题库' : certificate.canStart ? (item.id === 'random' && randomStarting ? '正在准备练习…' : item.id === 'random' && freePracticeText ? freePracticeText : item.note) : '待补充 · 暂不可开始'}}</text>
      </view>
      <t-icon wx:if="{{item.emphasized}}" name="chevron-right" size="34rpx" />
    </view>
  </view>

</view>
<membership-prompt id="membership-prompt" visible="{{showMembershipPrompt}}" bind:close="onCloseMembershipPrompt" bind:confirm="onConfirmMembershipPrompt" />
