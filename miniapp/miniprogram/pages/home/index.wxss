.home-page {
  padding-top: 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.user-bar,
.user-profile,
.resume-card,
.action-card {
  display: flex;
  align-items: center;
}

.user-bar {
  justify-content: space-between;
  gap: 20rpx;
}

.user-profile {
  min-width: 0;
  gap: 18rpx;
}

.user-avatar {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: var(--color-primary);
}

.user-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
}

.user-copy {
  min-width: 0;
}

.user-copy__meta {
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.user-copy__name {
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-entry {
  flex: 0 0 auto;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.home-title {
  margin-top: 40rpx;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.resume-card {
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: var(--radius-xl);
  background: #11120f;
  color: #fff;
  box-shadow: var(--shadow-soft);
}

.resume-card__copy {
  min-width: 0;
}

.resume-card__label {
  color: rgb(255 255 255 / 62%);
  font-size: 21rpx;
}

.resume-card__title {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-card__action {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #11120f;
  font-size: 23rpx;
  font-weight: 700;
}

.section-heading {
  margin: 48rpx 4rpx 18rpx;
}

.section-title {
  font-size: 33rpx;
  font-weight: 680;
}

.section-note {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.action-card {
  min-height: 150rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.action-card--emphasized {
  grid-column: 1 / -1;
  min-height: 112rpx;
  background: var(--color-primary);
}

.action-card--chapter {
  grid-column: 1;
  grid-row: 1;
}

.action-card--favorite {
  grid-column: 2;
  grid-row: 1;
}

.action-card--random {
  grid-column: 1 / -1;
  grid-row: 2;
}

.action-card__icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-text);
}

.action-card--emphasized .action-card__icon {
  background: rgb(255 255 255 / 48%);
}

.action-card__copy {
  min-width: 0;
}

.action-card__title {
  font-size: 27rpx;
  font-weight: 650;
}

.action-card__note {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.action-card--emphasized .action-card__copy {
  flex: 1;
}

.action-card--emphasized .action-card__note {
  color: rgb(17 18 15 / 68%);
}

.load-retry {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 26rpx;
}
