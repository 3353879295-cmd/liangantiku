.practice-page {
  --practice-option-selected-background: #e7f2c9;
  --practice-option-selected-text: #243600;
  --practice-option-selected-accent: #536f13;
  --practice-option-selected-key-text: #fff;
  --practice-option-correct-background: #e3f3eb;
  --practice-option-correct-text: #164d35;
  --practice-option-correct-accent: #28734f;
  --practice-option-correct-key-text: #fff;
  --practice-option-wrong-background: #fff0ee;
  --practice-option-wrong-text: #862820;
  --practice-option-wrong-accent: #b43b32;
  --practice-option-wrong-key-text: #fff;

  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--color-bg);
  color: var(--color-text);
  transition:
    background-color 200ms ease,
    color 200ms ease;
}

.practice-page.theme-night {
  --practice-option-selected-background: #303e1b;
  --practice-option-selected-text: #f2f8e4;
  --practice-option-selected-accent: #b8ec32;
  --practice-option-selected-key-text: #202c0d;
  --practice-option-correct-background: #173c2e;
  --practice-option-correct-text: #d8f8e7;
  --practice-option-correct-accent: #6fe0aa;
  --practice-option-correct-key-text: #103323;
  --practice-option-wrong-background: #492421;
  --practice-option-wrong-text: #ffe4df;
  --practice-option-wrong-accent: #ff9b90;
  --practice-option-wrong-key-text: #40201b;
}

.practice-content {
  transform-origin: center top;
}

.practice-content--previous {
  animation: practice-enter-previous 180ms ease-out;
}

.practice-content--next {
  animation: practice-enter-next 180ms ease-out;
}

.practice-content--rebound-previous {
  animation: practice-rebound-previous 180ms ease-out;
}

.practice-content--rebound-next {
  animation: practice-rebound-next 180ms ease-out;
}

.practice-topbar,
.practice-topbar__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.practice-topbar__actions {
  gap: 16rpx;
}

.practice-topbar__mode {
  margin-bottom: 4rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.practice-topbar__index {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.answer-sheet-link {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--practice-option-selected-text);
  font-size: 24rpx;
  font-weight: 600;
}

.progress-track {
  overflow: hidden;
  height: 6rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: var(--color-border);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width 180ms ease;
}

.question-card {
  margin-top: 34rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.question-type {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--practice-option-selected-text);
  font-size: 22rpx;
  font-weight: 600;
}

.question-module {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.question-stem {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 34rpx;
  font-weight: 550;
  line-height: 1.65;
}

.multiple-tip {
  overflow-wrap: anywhere;
  display: block;
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 26rpx;
}

.footer-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.practice-footer {
  position: fixed;
  z-index: 10;
  display: flex;
  align-items: center;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 16rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: rgb(245 245 247 / 94%);
}

.theme-night .practice-footer {
  background: rgb(21 25 17 / 94%);
}

.primary-button,
.navigation-button {
  flex: 1;
  min-height: 92rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.navigation-button {
  background: var(--color-primary);
  color: #11120f;
}

.navigation-button--previous {
  background: var(--color-surface);
  color: var(--color-text);
}

.navigation-button--previous[disabled] {
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
  opacity: 1;
}

.primary-button--confirm {
  flex: 1.15;
  background: #11120f;
  color: #fff;
  transition:
    transform 100ms ease,
    background-color 200ms ease;
}

.theme-night .primary-button--confirm {
  background: var(--color-primary-strong);
  color: #11120f;
}

.primary-button--confirm[disabled] {
  background: #e7e9e1;
  color: #979d90;
  opacity: 1;
}

.theme-night .primary-button--confirm[disabled] {
  background: var(--color-surface-secondary);
  color: var(--color-text-secondary);
}

.primary-button::after,
.navigation-button::after {
  display: none;
}

@keyframes practice-enter-previous {
  from {
    opacity: 0.88;
    transform: translateX(-20rpx);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes practice-enter-next {
  from {
    opacity: 0.88;
    transform: translateX(20rpx);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes practice-rebound-previous {
  50% {
    transform: translateX(14rpx);
  }
}

@keyframes practice-rebound-next {
  50% {
    transform: translateX(-14rpx);
  }
}

.practice-quota {
  padding: var(--space-2) var(--space-4);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.practice-retry {
  margin: var(--space-4);
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-text);
}
