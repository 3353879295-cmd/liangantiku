<view class="practice-page {{themeClass}}">
  <app-topbar title="答题练习" subtitle="{{modeLabel}}" fallback-tab="home" />
  <view wx:if="{{!loading && question}}">
    <view wx:if="{{freePracticeText}}" class="practice-quota">{{freePracticeText}}</view>
    <view
      class="practice-content {{transitionClass}}"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <view class="practice-topbar">
        <view>
          <view class="practice-topbar__mode">{{modeLabel}}</view>
          <text class="practice-topbar__index">{{indexText}}</text>
        </view>
        <view class="practice-topbar__actions">
          <theme-toggle theme="{{theme}}" bind:change="onToggleTheme" />
          <favorite-button active="{{favorite}}" bind:change="onToggleFavorite" />
          <view class="answer-sheet-link" bind:tap="onOpenAnswerSheet">答题卡</view>
        </view>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
      </view>

      <view class="question-card">
        <view class="question-meta">
          <text class="question-type">{{questionTypeLabel}}</text>
          <text class="question-module">{{question.module}}</text>
        </view>
        <view class="question-stem">{{question.stem}}</view>
        <text wx:if="{{multipleTipText}}" class="multiple-tip">{{multipleTipText}}</text>
      </view>

      <view class="option-list">
        <question-option
          wx:for="{{options}}"
          wx:key="key"
          option-key="{{item.key}}"
          text="{{item.text}}"
          selected="{{item.selected}}"
          state="{{item.state}}"
          disabled="{{item.disabled}}"
          bind:select="onSelectOption"
        />
      </view>

      <analysis-panel
        visible="{{analysisVisible}}"
        correct="{{analysisCorrect}}"
        selected-text="{{selectedText}}"
        expected-text="{{expectedText}}"
        explanation="{{question.explanation}}"
        knowledge-point="{{question.knowledgePoint}}"
        common-mistake="{{question.commonMistake || ''}}"
        standard-reference="{{question.standardReference}}"
        question-id="{{question.id}}"
      />

      <view class="footer-spacer"></view>
    </view>
    <view class="practice-footer">
      <button
        class="navigation-button navigation-button--previous"
        disabled="{{isFirst}}"
        aria-label="上一题"
        bindtap="onPrevious"
      >上一题</button>
      <button
        wx:if="{{showConfirm}}"
        class="primary-button primary-button--confirm"
        disabled="{{!canConfirm}}"
        aria-label="确认当前答案"
        bindtap="onConfirmAnswer"
      >确认答案</button>
      <button
        class="navigation-button navigation-button--next"
        aria-label="{{isLast ? '打开答题卡' : '下一题'}}"
        bindtap="onNext"
      >{{isLast ? '答题卡' : '下一题'}}</button>
    </view>
  </view>

  <empty-state
    wx:elif="{{!loading}}"
    title="{{errorTitle}}"
    description="{{errorDescription}}"
  />
  <empty-state wx:else kind="loading" title="正在准备题目" description="准备完成后即可开始作答" />
  <app-toast
    visible="{{toastVisible}}"
    message="{{toastMessage}}"
    bind:close="onToastClose"
  />
  <button wx:if="{{!loading && !sessionReady}}" class="practice-retry" bindtap="onRetryLoad">重新尝试</button>
  <membership-prompt visible="{{memberPromptVisible}}" bind:close="onCloseMemberPrompt" bind:confirm="onOpenMember" />
</view>
